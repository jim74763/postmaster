# Option 1: persistent OAuth credentials.
POSTMASTER_CLIENT_ID=
POSTMASTER_CLIENT_SECRET=
POSTMASTER_REFRESH_TOKEN=

# Optional: use a fixed callback URL instead of a random loopback port.
# POSTMASTER_OAUTH_REDIRECT_URI=http://127.0.0.1:33333/oauth2callback

# Option 2: short-lived token for quick testing.
# POSTMASTER_ACCESS_TOKEN=

# Option 3: authorized_user JSON file.
# POSTMASTER_OAUTH_CREDENTIALS_FILE=/absolute/path/to/postmaster-authorized-user.json
